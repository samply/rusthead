---
source: src/config.rs
expression: file
info: services/cce-beam-proxy.yml
input_file: tests/configs/cce.toml
---
services:
  cce-beam-proxy:
    image: docker.verbis.dkfz.de/cache/samply/beam-proxy:develop
    environment:
      BROKER_URL: https://broker.cce.dkfz.de/
      PROXY_ID: dummy.broker.cce.dkfz.de
      APP_focus_KEY: "${CCE_BEAM_PROXY_FOCUS_KEY}"
      ROOTCERT_FILE: /conf/root.crt.pem
      PRIVKEY_FILE: /run/secrets/proxy.pem
      TLS_CA_CERTIFICATES_DIR: /conf/trusted-ca-certs
      ALL_PROXY: http://forward-proxy:3128/
    volumes:
      - [TMP_DIR]/trusted-ca-certs:/conf/trusted-ca-certs:ro
    secrets:
      - proxy.pem
    configs:
      - source: cce.root.crt.pem
        target: /conf/root.crt.pem

configs:
  cce.root.crt.pem:
    content: |
