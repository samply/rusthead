---
source: src/config.rs
expression: file
info: services/cce-teiler.yml
input_file: tests/configs/cce.toml
---

services:
  cce-teiler-orchestrator:
    image: docker.verbis.dkfz.de/cache/samply/teiler-orchestrator:latest
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cce-teiler_orchestrator.rule=PathPrefix(`/cce-teiler`)"
      - "traefik.http.services.cce-teiler_orchestrator.loadbalancer.server.port=9000"
      - "traefik.http.routers.cce-teiler_orchestrator.tls=true"
      - "traefik.http.middlewares.cce-teiler_orchestrator_strip.stripprefix.prefixes=/cce-teiler"
      - "traefik.http.routers.cce-teiler_orchestrator.middlewares=cce-teiler_orchestrator_strip"
    environment:
      TEILER_BACKEND_URL: "/cce-teiler-backend"
      TEILER_DASHBOARD_URL: "/cce-teiler-dashboard"
      DEFAULT_LANGUAGE: "en"
      HTTP_RELATIVE_PATH: "/cce-teiler"

  cce-teiler-dashboard:
    image: docker.verbis.dkfz.de/cache/samply/teiler-dashboard:latest
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cce-teiler_dashboard.rule=PathPrefix(`/cce-teiler-dashboard`)"
      - "traefik.http.services.cce-teiler_dashboard.loadbalancer.server.port=80"
      - "traefik.http.routers.cce-teiler_dashboard.tls=true"
      - "traefik.http.middlewares.cce-teiler_dashboard_strip.stripprefix.prefixes=/cce-teiler-dashboard"
      - "traefik.http.routers.cce-teiler_dashboard.middlewares=cce-teiler_dashboard_strip"
    environment:
      DEFAULT_LANGUAGE: "EN"
      TEILER_BACKEND_URL: "/cce-teiler-backend"
      TEILER_DASHBOARD_URL: "/cce-teiler-dashboard"
      OIDC_URL: "https://sso.verbis.dkfz.de/application/o/dummy-public/"
      OIDC_CLIENT_ID: "dummy-public"
      OIDC_TOKEN_GROUP: "groups"
      TEILER_ADMIN_NAME: ""
      TEILER_ADMIN_EMAIL: ""
      TEILER_ADMIN_PHONE: ""
      TEILER_PROJECT: "cce"
      EXPORTER_API_KEY: "${CCE_EXPORTER_API_KEY}"
      TEILER_ORCHESTRATOR_URL: "/cce-teiler"
      TEILER_ORCHESTRATOR_HTTP_RELATIVE_PATH: "/cce-teiler"
      TEILER_USER: "CCE_Dummy"
      TEILER_ADMIN: "CCE_Dummy_Verwalter"
      REPORTER_DEFAULT_TEMPLATE_ID: "cce-qb"
      EXPORTER_DEFAULT_TEMPLATE_ID: "cce"


  cce-teiler-backend:
    image: docker.verbis.dkfz.de/ccp/cce-teiler-backend:latest
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cce-teiler_backend.rule=PathPrefix(`/cce-teiler-backend`)"
      - "traefik.http.services.cce-teiler_backend.loadbalancer.server.port=8085"
      - "traefik.http.routers.cce-teiler_backend.tls=true"
      - "traefik.http.middlewares.cce-teiler_backend_strip.stripprefix.prefixes=/cce-teiler-backend"
      - "traefik.http.routers.cce-teiler_backend.middlewares=cce-teiler_backend_strip"
    environment:
      LOG_LEVEL: "INFO"
      APPLICATION_PORT: "8085"
      DEFAULT_LANGUAGE: "EN"
      TEILER_ORCHESTRATOR_HTTP_RELATIVE_PATH: "/cce-teiler"
      TEILER_ORCHESTRATOR_URL: "/cce-teiler"
      TEILER_DASHBOARD_DE_URL: "/cce-teiler-dashboard/de"
      TEILER_DASHBOARD_EN_URL: "/cce-teiler-dashboard/en"
      HTTP_PROXY: http://forward-proxy:3128/
      BLAZE_CHECK_URL: http://cce-blaze:8080/fhir
      EXPORTER_CHECK_URL: "http://cce-exporter:8092/info"
      REPORTER_CHECK_URL: "http://cce-reporter:8095/info"
      ENABLE_MTBA: false
      ENABLE_DATASHIELD: false
