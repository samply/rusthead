---
source: src/config.rs
expression: file
info: services/gbn-hap-blaze-focus.yml
input_file: tests/configs/example.config.toml
---
services:
  gbn-hap-blaze-focus:
    image: docker.verbis.dkfz.de/cache/samply/focus:develop
    environment:
      BEAM_APP_ID_LONG: hap-focus.dummy.broker.bbmri.de
      BEAM_PROXY_URL: http://gbn-beam-proxy:8081/
      ENDPOINT_URL: http://hap-blaze:8080/fhir/
      API_KEY: "${GBN_BEAM_PROXY_HAP_FOCUS_KEY}"
      RETRY_COUNT: 128
      EPSILON: 0.28
      ENDPOINT_TYPE: blaze
