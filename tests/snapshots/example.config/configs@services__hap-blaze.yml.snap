---
source: src/config.rs
expression: file
info: services/hap-blaze.yml
input_file: tests/configs/example.config.toml
---


services:
  hap-blaze:
    image: docker.verbis.dkfz.de/cache/samply/blaze:latest
    environment:
      BASE_URL: http://hap-blaze:8080
      ENFORCE_REFERENTIAL_INTEGRITY: "false"
      DB_BLOCK_CACHE_SIZE: "1024"
      CQL_EXPR_CACHE_SIZE: "128"
    volumes:
      - "hap-blaze-data:/app/data"
    

volumes:
  hap-blaze-data:
