---
source: src/config.rs
expression: file
info: services/ccp-blaze-focus.yml
input_file: tests/configs/tuning.toml
---
services:
  ccp-blaze-focus:
    image: docker.verbis.dkfz.de/cache/samply/focus:main
    environment:
      BEAM_APP_ID_LONG: focus-ccp-blaze.dummy.broker.ccp-it.dktk.dkfz.de
      BEAM_PROXY_URL: http://ccp-beam-proxy:8081/
      ENDPOINT_URL: http://ccp-blaze:8080/fhir/
      API_KEY: "${CCP_BEAM_PROXY_FOCUS_CCP_BLAZE_KEY}"
      RETRY_COUNT: 128
      EPSILON: 0.28
      ENDPOINT_TYPE: blaze
