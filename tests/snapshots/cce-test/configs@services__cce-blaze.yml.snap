---
source: src/config.rs
expression: file
info: services/cce-blaze.yml
input_file: tests/configs/cce-test.toml
---


services:
  cce-blaze:
    image: docker.verbis.dkfz.de/cache/samply/blaze:latest
    environment:
      BASE_URL: http://cce-blaze:8080
      ENFORCE_REFERENTIAL_INTEGRITY: "false"
      DB_BLOCK_CACHE_SIZE: "1024"
      CQL_EXPR_CACHE_SIZE: "128"
    volumes:
      - "cce-blaze-data:/app/data"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cce-blaze.rule=PathPrefix(`/cce-localdatamanagement`)"
      - "traefik.http.middlewares.cce-blaze_strip.stripprefix.prefixes=/cce-localdatamanagement"
      - "traefik.http.services.cce-blaze.loadbalancer.server.port=8080"
      - "traefik.http.routers.cce-blaze.middlewares=cce-blaze_strip,cce-blaze"
      - "traefik.http.routers.cce-blaze.tls=true"

volumes:
  cce-blaze-data:
