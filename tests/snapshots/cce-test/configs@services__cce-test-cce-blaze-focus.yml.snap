---
source: src/config.rs
expression: file
info: services/cce-test-cce-blaze-focus.yml
input_file: tests/configs/cce-test.toml
---
services:
  cce-test-cce-blaze-focus:
    image: docker.verbis.dkfz.de/cache/samply/focus:main
    environment:
      BEAM_APP_ID_LONG: focus.dummy.test-no-real-data.broker.samply.de
      BEAM_PROXY_URL: http://cce-test-beam-proxy:8081/
      ENDPOINT_URL: http://cce-blaze:8080/fhir/
      API_KEY: "${CCE_TEST_BEAM_PROXY_FOCUS_KEY}"
      RETRY_COUNT: 128
      EPSILON: 0.28
      ENDPOINT_TYPE: blaze
